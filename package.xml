<?xml version="1.0"?>
<package format="3">
  <name>force_n</name><version>0.1.0</version>
  <description>Forcen calibrated serial force sensor with Qt GUI and ROS 2 wrench publishing.</description>
  <maintainer email="erie_lab@example.com">erie_lab</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>geometry_msgs</exec_depend>
