# Persistent Forcen sensor aliases, matched by unique USB serial number.
# These rules identify tools owned by CWRU ERIE Lab
# (Case Western Reserve University). Serial numbers are specific to these tools.
# Add one rule per additional sensor, with a unique serial and alias.
# Install into /etc/udev/rules.d/ following the repository README instructions.
# Then reload rules with: sudo udevadm control --reload-rules
# Reconnect the sensors to create their named aliases under /dev/.
# These aliases follow the sensors regardless of ttyACM numbering or USB port.

# CLASSIC_LND: observed as /dev/ttyACM0 on 2026-10-27.
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{serial}=="2084358A4242", SYMLINK+="CLASSIC_LND"

# S_LND: observed as /dev/ttyACM1 on 2026-10-27.
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{serial}=="206B35894242", SYMLINK+="S_LND"

# CLASSIC_MBF: observed as /dev/ttyACM1 on 2026-10-27.
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{serial}=="209F35894242", SYMLINK+="CLASSIC_MBF"

# S_MBF: observed as /dev/ttyACM0 on 2026-10-27.
SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", ATTRS{serial}=="205D358E4242", SYMLINK+="S_MBF"
